{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug-dev",
      "displayName": "Debug with dev-only crypto",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../build-debug-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_LIBOQS": "OFF",
        "DEV_ONLY_ALLOW_INSECURE_CRYPTO": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release with liboqs required",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USE_LIBOQS": "ON",
        "DEV_ONLY_ALLOW_INSECURE_CRYPTO": "OFF"
      }
    },
    {
      "name": "asan-dev",
      "displayName": "ASAN development build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../build-asan-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USE_LIBOQS": "OFF",
        "DEV_ONLY_ALLOW_INSECURE_CRYPTO": "ON",
        "PQC_ENABLE_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug-dev", "configurePreset": "debug-dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-dev", "configurePreset": "asan-dev" }
  ],
  "testPresets": [
    { "name": "debug-dev", "configurePreset": "debug-dev", "output": { "outputOnFailure": true } }
  ]
}
